# Public configuration: these NEXT_PUBLIC_ values are available to browser code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only Google Drive Service Account credentials. Never expose these to
# browser code or commit real credentials.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Optional server-only key. Add a real value only when a trusted server-side
# operation requires it. Never expose it to browser/client code.
SUPABASE_SERVICE_ROLE_KEY=
